# ===== REQUIRED =====
GEMINI_API_KEY=your_key_here
# Optional: add more keys for rotation (comma-separated)
# GEMINI_API_KEYS=key1,key2,key3

# ===== SERVER =====
PORT=5000
DATABASE_PATH=data/videolens.db
FLASK_SECRET_KEY=change_this_to_a_random_64_char_string
ADMIN_PASSWORD=choose_a_strong_admin_password
# Owner email (receives unlimited free access + priority AI tier)
OWNER_EMAIL=ganeshmalli954@gmail.com

# ===== OAUTH (Optional - login features disabled if not set) =====
# Get from: console.cloud.google.com → APIs → OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Get from: developer.twitter.com
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# Get from: developers.facebook.com
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# ===== OPTIONAL =====
# Get free at: console.groq.com (for Tier 3 audio transcription fallback)
GROQ_API_KEY=

# Buy Me a Coffee page URL
BMC_URL=https://www.buymeacoffee.com/videolens
